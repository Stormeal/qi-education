{
  "name": "qi-education",
  "version": "0.1.31",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "app:dev": "node scripts/run-app-dev.mjs",
    "app:dev:frontend": "npm --prefix app run start --",
    "app:build": "npm --prefix app run build",
    "app:build:pages": "npm --prefix app run build -- --base-href /qi-education/ --deploy-url /qi-education/ && node scripts/create-pages-fallback.mjs",
    "app:test": "npm --prefix app test",
    "api:dev": "npm --prefix api run dev",
    "api:build": "npm --prefix api run build",
    "api:test": "npm --prefix api test",
    "env:pull": "npx vercel env pull api/.env --environment=development --yes",
    "doctor": "node scripts/doctor.mjs"
  },
  "workspaces": [
    "app",
    "api"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
