# Local stores are isolated by default, even with shared keys below.
# Only exact USE_SHARED_SERVICES=1 opts a local run into shared services.
# NODE_ENV=production or a defined VERCEL variable is hosted and ignores this setting.
# NODE_ENV=test always stays isolated. Mail selection is unchanged.
USE_SHARED_SERVICES=0
# Shared/hosted accounts stay in Sheets until an explicit, verified cutover.
USER_STORE=google-sheets
# Set to 1 during forward migration and rollback; account reads/sign-in still work.
USER_STORE_READ_ONLY=0
PORT=3001
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_COURSES_RANGE=Courses!A:R
GOOGLE_SHEETS_USERS_RANGE=Users!A:H
GOOGLE_SHEETS_FEEDBACK_RANGE=Feedback!A:M
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPOSITORY=Stormeal/qi-education
GITHUB_FEEDBACK_PROJECT_ID=
MONGODB_URI=
MONGODB_DB_NAME=
MONGODB_COURSE_CONTENT_COLLECTION=
MONGODB_COURSE_ASSET_COLLECTION=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_DEFAULT_PLAYBACK_POLICY=public
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
